{
  "name": "@sakoocloud/ai",
  "version": "0.8.1",
  "type": "module",
  "description": "Give your AI coding tool full control of SakooCloud — deploy apps, provision databases, manage domains, DNS, backups, and more (PaaS + DBaaS for sakoocloud). MCP server.",
  "private": false,
  "license": "SEE LICENSE IN LICENSE",
  "author": "SakooCloud <support@sakoocloud.cloud> (https://sakoocloud.ir)",
  "homepage": "https://sakoocloud.ir",
  "bugs": {
    "url": "https://github.com/sakoocloud/sakoocloud-ai/issues"
  },
  "keywords": [
    "sakoocloud",
    "ai",
    "mcp",
    "model-context-protocol",
    "agent",
    "sdk",
    "paas",
    "dbaas",
    "deploy",
    "claude",
    "cursor",
    "codex",
    "copilot"
  ],
  "bin": {
    "sakoocloud-ai": "dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sakoocloud/sakoocloud-ai.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "release:first": "git tag -a v$npm_package_version -m v$npm_package_version && git push origin main --follow-tags",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags"
  },
  "dependencies": {
    "@sakoocloud/sdk": "^0.6.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "conf": "^13.1.0",
    "zod": "^3.25.76"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "package.json",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
